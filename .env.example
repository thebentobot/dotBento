# dotBento Bot Environment Variables
# Copy this file to .env and fill in your values
# .env files are loaded automatically in development

# ===========================================
# REQUIRED - Bot will not start without these
# ===========================================

# Discord Bot Token (from Discord Developer Portal)
Discord__Token=your_discord_bot_token_here

# PostgreSQL connection string
PostgreSQL__ConnectionString=Host=localhost;Port=5432;Username=postgres;Password=password;Database=bento;Command Timeout=60;Timeout=60;Persist Security Info=True

# Redis/Valkey connection string (for distributed caching)
Valkey__ConnectionString=localhost:6379

# ===========================================
# OPTIONAL - Some commands might not work because of these missing
# ===========================================

# Environment name - controls behavior of certain features:
#   local      - Development mode. Loki logging disabled, metrics pusher disabled.
#   staging    - Pre-production testing. Loki logging enabled, metrics pusher enabled.
#   production - Live bot. Loki logging enabled, metrics pusher enabled.
Environment=local

# Discord webhook for error logging
Discord__LogWebhookId=
Discord__LogWebhookToken=

# Last.fm API (for music commands)
LastFmApiKey=

# OpenWeather API (for weather commands)
OpenWeatherApiKey=

# Spotify API (for Spotify integration)
Spotify__Key=
Spotify__Secret=

# Bot listing services: each nonempty token enables only that provider.
# Bot ID is taken from the logged-in Discord bot.
BotLists__TopGgApiToken=
BotLists__DiscordBotsGgToken=
BotLists__DiscordBotListToken=

# Prometheus metrics
Prometheus__MetricsPusherEndpoint=
Prometheus__MetricsPusherName=

# Grafana Loki logging
LokiUrl=http://localhost:3100
# Set false in both bot and Web API environments to disable their Loki sink.
# Console logging remains enabled. Omitted = true (existing behaviour).
Logging__LokiEnabled=true

# Use the same prefix for a bot and its Web API; different prefixes for
# independent deployments sharing Redis. Omitted = dotbento:
Cache__Prefix=dotbento:

# Image server - full URL to the image rendering endpoint
# Default: Sushii image server at http://localhost:3000/html
ImageServer__Url=http://localhost:3000/html

# bento-media-server (for TikTok/Twitter media and horoscope commands)
# With features enabled, an empty URL returns a friendly unavailable response.
# Use MediaServer__Enabled=false below to remove these commands entirely.
MediaServer__Url=
MediaServer__ApiKey=

# Bot settings (loaded from environment variables or this .env file)
# Leave empty for the automatic user/server-count activity.
Bot__Status=
# Support guild for membership badges in profile images; 0 disables lookup.
Bot__BaseServerId=714496317522444352
Bot__AnnouncementChannelId=0

# Private API features: enabled by default for existing deployments.
# Set the master switch to false to run without bento-media-server and hide
# both /media and /horoscope. Settings take effect after restarting the bot.
MediaServer__Enabled=true
Features__MediaEnabled=true
Features__HoroscopeEnabled=true

# Patreon benefits and promotions; also set this in the Web API environment.
# Disabling keeps saved supporter records for later re-enabling.
Features__PatreonEnabled=true

# Reward promises in about/welcome links; false uses generic support/vote text.
# Reward fulfilment is external to this repository and must be configured there.
Features__DonationRewardsEnabled=true
Features__VotingRewardsEnabled=true

# Command registration: 0 = global; set your development guild ID for local use.
# This setting applies in both Debug and Release builds.
Bot__CommandGuildId=0
# Omit to keep guild data outside production and delete it in production.
# Explicit true/false overrides the environment default.
# Bot__KeepGuildDataOnLeave=true

# Bot identity and gift terminology
Branding__Name=Bento
Branding__Description=A Discord bot with media and entertainment commands.
Branding__Emoji=🍱
Branding__GiftName=Bento Box
Branding__GiftPluralName=Bento Boxes
Branding__GiftEmoji=🍱

# Only these brand-specific command segments are configurable.
Branding__GiftCommandName=bento
Branding__AboutCommandName=bento
Branding__GiftLeaderboardName=bento

# Links: omitted = Bento defaults; explicitly empty = hide associated links.
Branding__WebsiteUrl=https://bentobot.xyz
Branding__DocumentationUrl=https://docs.bentobot.xyz
Branding__SupportUrl=https://discord.gg/dd68WwP
Branding__SourceUrl=https://github.com/thebentobot/bento
Branding__PatreonUrl=https://www.patreon.com/bentobot
Branding__KoFiUrl=https://ko-fi.com/bentobot
Branding__VoteUrl=https://top.gg/bot/787041583580184609/vote

# Optional page overrides: omit to derive the existing paths from WebsiteUrl
# or DocumentationUrl. Explicit empty = disable that page and related controls.
# LeaderboardUrl is a base URL; server links append /<guildId>.
# A landing-page-only website can set FeaturesUrl and LeaderboardUrl empty.
# Branding__FeaturesUrl=
# Branding__LeaderboardUrl=
# Branding__TroubleshootingUrl=
# Branding__ServerSettingsGuideUrl=

# Semantic embed palette: six hex digits, optionally prefixed with #.
# Quote values beginning with # so dotenv parsers treat them as values.
Theme__Primary="FDE047"
Theme__Success="32CD32"
Theme__Warning="FFAE42"
Theme__Error="FF0000"
Theme__Information="448AFF"

# Portable pagination controls. Custom Discord emoji such as
# <:first:883825508633182208> are also accepted. Each must be distinct.
Pagination__First=⏮️
Pagination__Previous=◀️
Pagination__Next=▶️
Pagination__Last=⏭️
Pagination__Jump=🔢

# Opt in only if a deployment requires complete Discord member caches.
Discord__AlwaysDownloadUsers=false
