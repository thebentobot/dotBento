<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[dotBento.*]*</Include>
          <Exclude>[*.Tests]*</Exclude>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
          <ExcludeByFile>**/Migrations/**/*.cs,**/dotBento.WebApi/Program.cs,**/dotBento.Bot/Program.cs,**/dotBento.Bot/Startup.cs,**/dotBento.Bot/Commands/SlashCommands/**/*.cs,**/dotBento.Bot/Commands/TextCommands/**/*.cs,**/dotBento.Bot/Commands/SharedCommands/AboutCommand.cs,**/dotBento.Bot/Commands/SharedCommands/AvatarCommand.cs,**/dotBento.Bot/Commands/SharedCommands/BannerCommand.cs,**/dotBento.Bot/Commands/SharedCommands/BentoCommand.cs,**/dotBento.Bot/Commands/SharedCommands/LastFmCommand.cs,**/dotBento.Bot/Commands/SharedCommands/MediaCommand.cs,**/dotBento.Bot/Commands/SharedCommands/ServerCommand.cs,**/dotBento.Bot/Commands/SharedCommands/ToolsCommand.cs,**/dotBento.Bot/Commands/SharedCommands/UrbanCommand.cs,**/dotBento.Bot/Commands/SharedCommands/UserCommand.cs,**/dotBento.Bot/ComponentInteractions/**/*.cs,**/dotBento.Bot/Handlers/ClientJoinedGuildHandler.cs,**/dotBento.Bot/Handlers/ClientLeftGuildHandler.cs,**/dotBento.Bot/Handlers/GuildMemberRemoveHandler.cs,**/dotBento.Bot/Handlers/GuildMemberUpdateHandler.cs,**/dotBento.Bot/Handlers/InteractionHandler.cs,**/dotBento.Bot/Handlers/MessageHandler.cs,**/dotBento.Bot/Handlers/UserUpdateHandler.cs,**/dotBento.Bot/AutoCompleteHandlers/SearchRemindersAutoComplete.cs,**/dotBento.Bot/AutoCompleteHandlers/SearchTagsAutoComplete.cs,**/dotBento.Bot/AutoCompleteHandlers/SearchTagsWhenModifyAutoComplete.cs,**/dotBento.Bot/Extensions/InteractionContextExtensions.cs,**/dotBento.Bot/Extensions/UserExtensions.cs,**/dotBento.Bot/Services/BackgroundService.cs,**/dotBento.Bot/Services/BotService.cs,**/dotBento.Bot/Services/BotListService.cs,**/dotBento.Bot/Services/DiscordUserResolver.cs,**/dotBento.Bot/Services/DmSender.cs,**/dotBento.Bot/Services/SpotifyApiService.cs</ExcludeByFile>
          <SkipAutoProps>true</SkipAutoProps>
          <SingleHit>false</SingleHit>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
